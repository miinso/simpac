// a rope.
using cloth.particle
using cloth.element

Config.Scene {
  dt { f32: { 1 / 60 } }
  gravity { vec3r: { x: 0, y: -9.81, z: 0 } }
  paused { bool: { false } }
}

const count = 12
const spacing = 0.8
const mass = 1.0
const stiffness = 1200.0
const spring_damping = 0.12
const start_y = 3.0

p_0 {
  Position: { x: 0, y: $start_y, z: 0 }
  Velocity: { x: 0, y: 0, z: 0 }
  Mass: { $mass }
  Particle
  IsPinned
}

for i in 1..$count {
  "p_$i" {
    Position: { x: $i * $spacing, y: $start_y, z: 0 }
    Velocity: { x: 0, y: 0, z: 0 }
    Mass: { $mass }
    Particle
  }
}

for i in 0..($count - 1) {
  "s_$i" {
    Spring: {
      v0: "p_$i",
      v1: "p_{$i + 1}",
      rest_length: $spacing,
      stiffness: $stiffness,
      damping: $spring_damping
    }
  }
}

MainCamera {
  Position: { x: 4, y: 2, z: 10 }
  graphics.Camera: {
    target: { x: 4, y: 1.5, z: 0 }
    fovy: 60
    projection: 0
  }
}

graphics.ActiveCameraSource {
  (graphics.ActiveCamera, MainCamera)
}

