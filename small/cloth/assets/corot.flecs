// corotational FEM cloth (triangles for membrane, bending springs for out-of-plane)
using cloth.particle
using cloth.element

Config.Scene {
  dt { f32: { 1 / 60 } }
  gravity { vec3r: { x: 0, y: -9.81, z: 0 } }
  paused { bool: { false } }
}

Config.Solver {
  cg_max_iter { i32: { 100 } }
  cg_tolerance { f32: { 0.00001 } }
}

const width = 50
const height = 50
const spacing = 0.9
const mass = 1.0
const mu = 400000.0
const lam = 40000.0
const thick = 0.01
const k_bending = 360.0
const k_d = 0.12
const start_x = -($width - 1) * $spacing * 0.5
const start_y = 3.0
const start_z = 0.0

// particles (grid)
for y in 0..$height {
  for x in 0..$width {
    "p_{$y}_{$x}" {
      Position: { x: $start_x + $x * $spacing, y: $start_y, z: $start_z - $y * $spacing }
      Velocity: { x: 0, y: 0, z: 0 }
      Mass: { $mass }
      Particle
    }
  }
}

// pin top row
for x in 0..$width {
  "p_0_{$x}" { IsPinned }
}

// triangles (each quad = 2 tris)
for y in 0..($height - 1) {
  for x in 0..($width - 1) {
    "t_a_{$y}_{$x}" {
      Triangle: {
        v0: "p_{$y}_{$x}",
        v1: "p_{$y}_{$x + 1}",
        v2: "p_{$y + 1}_{$x}",
        mu: $mu,
        lambda: $lam,
        thickness: $thick
      }
    }
    "t_b_{$y}_{$x}" {
      Triangle: {
        v0: "p_{$y}_{$x + 1}",
        v1: "p_{$y + 1}_{$x + 1}",
        v2: "p_{$y + 1}_{$x}",
        mu: $mu,
        lambda: $lam,
        thickness: $thick
      }
    }
  }
}

// bending springs (horizontal, skip one)
for y in 0..$height {
  for x in 0..($width - 2) {
    "s_bh_{$y}_{$x}" {
      Spring: {
        v0: "p_{$y}_{$x}",
        v1: "p_{$y}_{$x + 2}",
        rest_length: $spacing * 2.0,
        stiffness: $k_bending,
        damping: $k_d * 0.5
      }
    }
  }
}

// bending springs (vertical, skip one)
for y in 0..($height - 2) {
  for x in 0..$width {
    "s_bv_{$y}_{$x}" {
      Spring: {
        v0: "p_{$y}_{$x}",
        v1: "p_{$y + 2}_{$x}",
        rest_length: $spacing * 2.0,
        stiffness: $k_bending,
        damping: $k_d * 0.5
      }
    }
  }
}

DefaultCamera {
  Position: { x: 0, y: 3, z: 10 }
  graphics.Camera: {
    target: { x: 0, y: 1.5, z: -2 }
    fovy: 60
    projection: 0
    move_speed: 0.1
    rotation_speed: 0.2
    zoom_speed: 1.0
  }
}

graphics.ActiveCameraSource {
  (graphics.ActiveCamera, DefaultCamera)
}
