// corotational FEM cloth (triangles for membrane, dihedral hinges for bending)
using cloth.particle
using cloth.element

Config.Scene {
  dt { f32: { 1 / 60 } }
  gravity { vec3r: { x: 0, y: -9.81, z: 0 } }
  paused { bool: { false } }
  default_dihedral_bending_stiffness { f32: { 0.0 } }
}

Config.Solver {
  cg_max_iter { i32: { 100 } }
  cg_tolerance { f32: { 0.00001 } }
}

const width = 20
const height = 20
const spacing = 0.9
const mass = 1.0
const mu = 100000.0
const lam = 100000.0
const thick = 0.01
const start_x = -($width - 1) * $spacing * 0.5
const start_y = 3.0
const start_z = 0.0

// particles (grid)
for y in 0..$height {
  for x in 0..$width {
    "p_{$y}_{$x}" {
      Position: { x: $start_x + $x * $spacing, y: $start_y, z: $start_z - $y * $spacing }
      Velocity: { x: 0, y: 0, z: 0 }
      Mass: { $mass }
      Particle
    }
  }
}

// pin top row
// for x in 0..$width {
//   "p_0_{$x}" { IsPinned }
// }

// or pin corners
p_0_0 { IsPinned }
"p_0_{$width - 1}" { IsPinned }

// triangles (each quad = 2 tris)
// hinges auto-generated from triangle adjacency (interior edges)
for y in 0..($height - 1) {
  for x in 0..($width - 1) {
    "t_a_{$y}_{$x}" {
      Triangle: {
        v0: "p_{$y}_{$x}",
        v1: "p_{$y}_{$x + 1}",
        v2: "p_{$y + 1}_{$x}",
        mu: $mu,
        lambda: $lam,
        thickness: $thick
      }
    }
    "t_b_{$y}_{$x}" {
      Triangle: {
        v0: "p_{$y}_{$x + 1}",
        v1: "p_{$y + 1}_{$x + 1}",
        v2: "p_{$y + 1}_{$x}",
        mu: $mu,
        lambda: $lam,
        thickness: $thick
      }
    }
  }
}

// explicit hinges (uncomment to override auto-generation)
// const dihedral_bending_stiffness = 1.0
// for y in 0..($height - 1) {
//   for x in 0..($width - 1) {
//     "h_{$y}_{$x}" {
//       Hinge: {
//         v0: "p_{$y}_{$x}",
//         v1: "p_{$y + 1}_{$x + 1}",
//         v2: "p_{$y}_{$x + 1}",
//         v3: "p_{$y + 1}_{$x}",
//         stiffness: $dihedral_bending_stiffness
//       }
//     }
//   }
// }

DefaultCamera {
  Position: { x: 0, y: 3, z: 10 }
  graphics.Camera: {
    target: { x: 0, y: 1.5, z: -2 }
    fovy: 60
    projection: 0
    move_speed: 0.1
    rotation_speed: 0.2
    zoom_speed: 1.0
  }
}

graphics.ActiveCameraSource {
  (graphics.ActiveCamera, DefaultCamera)
}
